{
  "name": "@nlabs/gothamjs",
  "version": "1.3.3",
  "description": "Platform",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "browser": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./components": {
      "default": "./lib/components/index.js",
      "import": "./lib/components/index.js",
      "types": "./lib/components/index.d.ts"
    },
    "./icons": {
      "default": "./lib/icons/index.js",
      "import": "./lib/icons/index.js",
      "types": "./lib/icons/index.d.ts"
    },
    "./i18n": {
      "default": "./lib/i18n/index.js",
      "import": "./lib/i18n/index.js",
      "types": "./lib/i18n/index.d.ts"
    },
    "./router": {
      "default": "./lib/router/index.js",
      "import": "./lib/router/index.js",
      "types": "./lib/router/index.d.ts"
    },
    "./form": {
      "default": "./lib/form/index.js",
      "import": "./lib/form/index.js",
      "types": "./lib/form/index.d.ts"
    },
    "./chat": {
      "default": "./lib/components/Chat/index.js",
      "import": "./lib/components/Chat/index.js",
      "types": "./lib/components/Chat/index.d.ts"
    },
    "./styles/tailwind.css": {
      "default": "./lib/styles/tailwind.css"
    }
  },
  "keywords": [
    "arkhamjs",
    "documentation",
    "flux",
    "gothamjs",
    "markdown",
    "nitrogenlabs",
    "react"
  ],
  "author": {
    "name": "Giraldo Rosales",
    "email": "giraldo@nitrogenx.co",
    "url": "http://nitrogenlabs.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nitrogenlabs/gothamjs.git"
  },
  "homepage": "http://gothamjs.io",
  "bugs": {
    "url": "https://github.com/nitrogenlabs/gothamjs/issues"
  },
  "scripts": {
    "build": "npm run tailwind:build && lex compile --remove --config ./tsconfig.build.json && npm run sync:tailwind-lib",
    "build:dev": "npm run tailwind:build && NODE_ENV=development lex compile --remove --config ./tsconfig.build.json && npm run sync:tailwind-lib",
    "clean": "lex clean",
    "dev": "npm run tailwind:build && npm run sync:tailwind-lib && lex dev",
    "lint": "lex lint --fix",
    "prepublishOnly": "npm test && npm run build",
    "publish:major": "npm version major && npm run publish:tags && npm publish",
    "publish:minor": "npm version minor && npm run publish:tags && npm publish",
    "publish:patch": "npm version patch && npm run publish:tags && npm publish",
    "publish:tags": "git push --tags && git push origin HEAD",
    "start": "npm run tailwind:build && npm run sync:tailwind-lib && lex dev -r -o",
    "test": "lex test",
    "update": "lex update --interactive",
    "watch": "lex compile -w",
    "storybook": "npm run tailwind:build && npm run sync:tailwind-lib && lex storybook",
    "sync:tailwind-lib": "node -e \"const fs=require('fs'); fs.mkdirSync('./lib/styles',{recursive:true}); fs.writeFileSync('./lib/styles/tailwind.css','@import \\\"./index.css\\\";\\n');\"",
    "tailwind:build": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./src/styles/index.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./src/styles/index.css --watch"
  },
  "browserslist": [
    "> 5%",
    "last 2 versions"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@nlabs/rip-hunter": "^3.1.1",
    "@nlabs/utils": "^2.10.5",
    "autosuggest-highlight": "^3.3.4",
    "cropperjs": "^2.1.1",
    "hast-util-sanitize": "5.0.2",
    "highlight.js": "^11.12.0",
    "history": "^5.3.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "progressbar.js": "^1.1.1",
    "react-autosuggest": "^10.1.0",
    "react-cropper": "^2.3.3",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-spinkit": "^3.0.0",
    "react-tag-autocomplete": "^7.5.1",
    "react-transition-group": "^4.4.5",
    "rehype-react": "^8.0.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nlabs/arkhamjs": "^3.31.9",
    "@nlabs/arkhamjs-middleware-logger": "^3.30.6",
    "@nlabs/arkhamjs-storage-browser": "^3.30.6",
    "@nlabs/arkhamjs-utils-react": "^3.32.7",
    "@nlabs/lex": "1.59.5",
    "@types/history": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/progressbar.js": "^1.1.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@nlabs/arkhamjs": "^3.31.4",
    "@nlabs/arkhamjs-middleware-logger": "^3.30.2",
    "@nlabs/arkhamjs-storage-browser": "^3.30.1",
    "@nlabs/arkhamjs-utils-react": "^3.32.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "http-proxy-middleware": "^3.0.5",
    "minimatch@9.0.9": {
      "brace-expansion": "^2.1.4"
    },
    "postcss-url": {
      "minimatch": "3.1.5"
    },
    "semver-regex": "^4.0.5",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
